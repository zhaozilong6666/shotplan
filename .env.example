# 默认 provider 是 mock：不需要任何账号、网络或 API key 即可完整跑通
SHOTPLAN_PROVIDER=mock

# 切换到真实模型时填写（任何 OpenAI 兼容端点都可以）
# SHOTPLAN_PROVIDER=openai_compatible
SHOTPLAN_LLM_BASE_URL=https://api.openai.com/v1
SHOTPLAN_LLM_API_KEY=
SHOTPLAN_LLM_MODEL=gpt-4o-mini
SHOTPLAN_LLM_TIMEOUT=30

# 成本杠杆（默认关闭；输出 token 通常占账单九成，见 docs/cost.md）
# SHOTPLAN_LLM_MAX_TOKENS=0          # 固定上限（与下面的自适应二选一）
# SHOTPLAN_LLM_ADAPTIVE_BUDGET=0     # 1 = 按方案规模估算，截断时自动提额
# SHOTPLAN_LLM_TEMPERATURE=0.2       # 0 更确定，但不直接省钱
# 推理强度（low | medium | high）。不支持的端点会自动丢弃该字段。
# 实测（deepseek-v4.1-flash，16 例）：low 让输出 token 均值 4529 -> 1848（-59%）、
# 延迟 81s -> 31s（-62%），硬约束 16/16、均分 0.9179 -> 0.9461，没有质量损失。
SHOTPLAN_LLM_REASONING_EFFORT=low
# SHOTPLAN_PROMPT_VERSION=           # 留空 = 当前默认；A/B 时显式指定 planner-v2 / v3
# SHOTPLAN_PROMPT_ROUTER=0           # 1 = 光线敏感 brief 用 v3；前瞻验证未通过，勿启用
# SHOTPLAN_LLM_ATTEMPTS=3            # 每次请求的尝试次数；中转站成片 502 时可调高

# 运行记录数据库
SHOTPLAN_DB_PATH=data/shotplan.db

# 运行历史写入策略：off（不写）| sync（响应前落库，默认）| async（写后置队列）
# async 更快，代价是进程被硬杀时队列里的行会丢；见 docs/persistence.md
SHOTPLAN_PERSIST_MODE=sync

# 启动时删除超过 N 天的运行记录；0 表示永久保留（默认）
SHOTPLAN_RETENTION_DAYS=0

# 单次请求的墙钟预算（秒），含全部修复轮次；0 表示关闭
SHOTPLAN_PIPELINE_BUDGET_S=120  # low推理实测P99=85s/最大88s；默认推理需180

# 校验失败后最多让模型自我修复几次
SHOTPLAN_MAX_REPAIRS=1

# 部署保护（默认全部关闭；公开部署时至少设置 key 与限流）
# SHOTPLAN_API_KEY=
# SHOTPLAN_RATE_LIMIT_PER_MINUTE=0
# SHOTPLAN_MAX_BODY_BYTES=1000000

# 评测基线阈值：低于此值 CI 会失败，防止 prompt 改动悄悄让质量退化
SHOTPLAN_EVAL_MIN_SCORE=0.80
SHOTPLAN_LOG_LEVEL=INFO
