# 默认 provider 是 mock：不需要任何账号、网络或 API key 即可完整跑通
SHOTPLAN_PROVIDER=mock

# 切换到真实模型时填写（任何 OpenAI 兼容端点都可以）
# SHOTPLAN_PROVIDER=openai_compatible
SHOTPLAN_LLM_BASE_URL=https://api.openai.com/v1
SHOTPLAN_LLM_API_KEY=
SHOTPLAN_LLM_MODEL=gpt-4o-mini
SHOTPLAN_LLM_TIMEOUT=30

# 运行记录数据库
SHOTPLAN_DB_PATH=data/shotplan.db

# 校验失败后最多让模型自我修复几次
SHOTPLAN_MAX_REPAIRS=1

# 评测基线阈值：低于此值 CI 会失败，防止 prompt 改动悄悄让质量退化
SHOTPLAN_EVAL_MIN_SCORE=0.80
SHOTPLAN_LOG_LEVEL=INFO
