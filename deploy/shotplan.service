[Unit]
Description=shotplan API
Documentation=https://github.com/zhaozilong6666/shotplan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shotplan
Group=shotplan
WorkingDirectory=/opt/shotplan
# Verified default: batch + 1 worker. Batch waits for a shared commit, and one
# process avoids the multi-process SQLite write contention measured in E29
# (2 workers already produced 30s tails; 1 worker ran 2h with none).
# For SHOTPLAN_PERSIST_MODE=sync, override SHOTPLAN_WORKERS=4 in /etc/shotplan.env.
Environment=SHOTPLAN_WORKERS=1
Environment=SHOTPLAN_PERSIST_MODE=batch
EnvironmentFile=/etc/shotplan.env
Environment=SHOTPLAN_DB_PATH=/var/lib/shotplan/shotplan.db
StateDirectory=shotplan
ExecStart=/opt/shotplan/.venv/bin/python -m uvicorn shotplan.api:app --host 127.0.0.1 --port 8000 --workers ${SHOTPLAN_WORKERS}
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
